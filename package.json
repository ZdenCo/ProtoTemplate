{
  "name": "agentweb-app",
  "private": true,
  "version": "0.1.0",
  "description": "Modular React frontend core for apps running inside ProtoShell.",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "validate": "vitest run --project validate",
    "e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run validate && npm run test && npm run build && npm run e2e",
    "sync:shell": "node scripts/sync-shell.mjs",
    "gen:capabilities": "node scripts/gen-capabilities.mjs",
    "new:module": "node scripts/new-module.mjs",
    "prune": "node scripts/prune.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@protoshell/capacitor-neural-tts": "file:vendor/protoshell-capacitor-neural-tts-0.1.0.tgz",
    "@protoshell/capacitor-shell": "file:vendor/protoshell-capacitor-shell-0.1.0.tgz",
    "@protoshell/capacitor-vlm": "file:vendor/protoshell-capacitor-vlm-0.1.0.tgz",
    "@protoshell/sdk": "file:vendor/protoshell-sdk-0.1.0.tgz",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-error-boundary": "6.1.6",
    "react-router": "8.4.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "uqr": "0.1.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
