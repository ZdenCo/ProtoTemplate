{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": [
      "vite/client"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@core": [
        "./src/core/index.ts"
      ],
      "@core/*": [
        "./src/core/*"
      ],
      "@modules/*": [
        "./modules/*"
      ],
      "@app/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src",
    "modules"
  ],
  "exclude": [
    "src/core/validate"
  ]
}
